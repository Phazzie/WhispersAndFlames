{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-worklog-plan.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the work log for a plan..."
          }
        ]
      }
    ]
  }
}
